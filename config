theme = "catppuccin-mocha.conf"
# font-family = "JetBrainsMono Nerd Font"
# font-family = "Iosevka Nerd Font"
# font-family-bold = "VictorMono Nerd Font"
# font-family-italic = "VictorMono Nerd Font"
# font-family-bold-italic = "VictorMono Nerd Font"

font-family = "Maple Mono NF"
font-style = "Thin"
# font-style = "ExtraLight"

font-family-bold = "Maple Mono NF"
font-style-bold = "Light"
# font-style-bold = "Light"

font-family-italic = "Maple Mono NF"
font-style-italic = "Thin Italic"
# font-style-italic = "ExtraLight"

font-family-bold-italic = "Maple Mono NF"
font-style-bold-italic = "Light Italic"
# font-style-bold-italic = "Light"

font-size = 20
font-thicken = true
macos-option-as-alt = true
shell-integration = fish
shell-integration-features = no-cursor,sudo,ssh-terminfo,ssh-env
keybind = ¥=text:\\
cursor-style = block_hollow

adjust-cell-height = 30%
