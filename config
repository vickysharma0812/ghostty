theme = "catppuccin-mocha.conf"
# font-family = "JetBrainsMono Nerd Font"
# font-family = "Iosevka Nerd Font"
# font-family-bold = "VictorMono Nerd Font"
# font-family-italic = "VictorMono Nerd Font"
# font-family-bold-italic = "VictorMono Nerd Font"

font-family = "FiraCode Nerd Font Mono"
font-style = "Retina"

# font-family = "IosevkaTerm Nerd Font Mono"
# font-style = "Light"

font-family-bold = "FiraCode Nerd Font Mono"
font-style-bold = "Medium"

# font-family-bold = "IosevkaTerm Nerd Font Mono"
# font-style-bold = "Medium"

font-family-italic = "FiraCode Nerd Font Mono"
font-style-italic = "Light"

# font-family-italic = "IosevkaTerm Nerd Font Mono"
# font-style-italic = "Light"

font-family-italic = "FiraCode Nerd Font Mono"
font-style-italic = "SemiBold"

# font-family-bold-italic = "IosevkaTerm Nerd Font Mono"
# font-style-bold-italic = "Bold"

font-size = 18
font-thicken = true
macos-option-as-alt = true
shell-integration = fish
shell-integration-features = no-cursor,sudo,ssh-terminfo,ssh-env
keybind = ¥=text:\\
keybind=cmd+s=text::w\x0d
cursor-style = block_hollow
adjust-cell-height = 40%
background-opacity = 0.85

# custom-shader = shaders/cursor_warp.glsl
# custom-shader = shaders/ripple_cursor.glsl
